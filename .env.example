# Copy to .env and adjust as needed
PORT=3000
NODE_ENV=development

# Secret key for Google / Siri voice endpoints (required in production).
# Callers must send this value in the X-Api-Key header.
API_KEY=

# Set to 'true' to bypass Alexa request-signature verification.
# Verification is automatically skipped when NODE_ENV != 'production'.
SKIP_ALEXA_VERIFY=true

# PostgreSQL connection string. When unset, an in-memory store is used (dev / tests).
# DATABASE_URL=postgresql://user:pass@localhost:5432/voice_gateway

# Minimum log level: debug | info | warn | error | silent (default: info)
LOG_LEVEL=info

# Voice-route request timeout in ms — Alexa requires a response within 8 s (default: 7500)
# REQUEST_TIMEOUT_MS=7500

# IoT core resilience — all values are optional, defaults shown
# IOT_TIMEOUT_MS=5000               # per-attempt timeout
# IOT_RETRY_MAX_ATTEMPTS=3          # total attempts (1 = no retry)
# IOT_RETRY_BASE_DELAY_MS=100       # base delay for exponential backoff
# IOT_CB_FAILURE_THRESHOLD=5        # consecutive failures before circuit opens
# IOT_CB_RESET_MS=30000             # ms to wait before probing again
